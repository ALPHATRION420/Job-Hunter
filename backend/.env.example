# To send REAL emails directly from your Gmail inbox:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# MongoDB Atlas Connection String Example:
# Replace <username>, <password>, and cluster URL with your MongoDB Atlas details:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=jobhunter

# To connect to MongoDB Atlas Cloud, paste your Atlas connection string below:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobhunter?retryWrites=true&w=majority

# LinkedIn Headless Scraper Credentials (Optional):
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── HR Email Discovery APIs (Optional — enables real recruiter email lookup) ──
#
# Hunter.io — finds recruiter/HR emails for any company domain
# Free tier: 25 searches/month  |  Sign up: https://hunter.io/users/sign_up
HUNTER_IO_API_KEY=

# Apollo.io — B2B database search for HR & recruiters
# Free tier available  |  Sign up: https://apollo.io
APOLLO_API_KEY=

# Adzuna — real Indian job listings API with company contact info
# Free tier available  |  Sign up: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
