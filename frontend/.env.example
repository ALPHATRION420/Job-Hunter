# Frontend Environment Variables
# Copy this to .env.local for local development, or set in Vercel dashboard for production.

# URL of the deployed backend API (Render.com URL after deployment)
# Example: https://jobhunter-api.onrender.com
VITE_API_URL=https://your-render-backend.onrender.com

# For local development, leave this blank or remove it entirely.
# The Vite dev proxy (vite.config.ts) will forward /api/* to localhost:8000 automatically.
# VITE_API_URL=
